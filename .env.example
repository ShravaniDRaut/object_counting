# App Settings
APP_NAME=AI Real-Time Object Counting System
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Computer Vision & ML Settings
MODEL_PATH=models/yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
TRACKER_TYPE=bytetrack.yaml
TARGET_CLASSES=[0, 1, 2, 3, 5, 7]

# Virtual Counting Line Default (Coordinates normalized 0.0 - 1.0 or pixels)
# Format: x1,y1,x2,y2
LINE_COORDS=0.1,0.5,0.9,0.5

# Database Settings
DATABASE_URL=sqlite:///./data/object_counting.db

# Storage Directories
UPLOAD_DIR=data/uploads
EXPORT_DIR=data/exports
SAMPLE_DIR=data/samples
